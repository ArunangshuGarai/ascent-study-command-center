# ASCENT server configuration
# Copy to .env (or set these in your host dashboard).

PORT=8787
DATA_DIR=./data
SESSION_DAYS=30

# Set to 1 when serving behind HTTPS in production. Set to 0 only for
# local HTTP testing. Leave empty to auto-detect x-forwarded-proto.
COOKIE_SECURE=

# Optional: hosted Turso/libSQL database. When TURSO_DATABASE_URL is set the
# server uses @libsql/client instead of the local SQLite file, and DATA_DIR
# is ignored. Required on Vercel.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
